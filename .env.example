# Local development works without an .env file. Copy this only to customize it.
APP_ENV=development
DEMO_MODE=true

# Optional overrides. Do not add real patient data to the demo workspace.
# DATA_DIR=/absolute/path/to/private/medguard-data
# DATABASE_URL=sqlite:////absolute/path/to/private/medguard.db

# Production: generate a private file with python scripts/configure-production.py.
# APP_ENV=production
# DEMO_MODE=false
# SECRET_KEY=<at least 32 random characters>
# ENCRYPTION_KEY=<base64 encoding of exactly 32 random bytes>
# TRUSTED_HOSTS=hospital.example,localhost,127.0.0.1

# Optional private AWS S3 storage. Leave S3_BUCKET empty for local encrypted files.
# S3_BUCKET=my-private-medguard-bucket
AWS_REGION=ap-south-1
# Prefer an IAM role. If environment credentials are necessary, use standard AWS names:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
