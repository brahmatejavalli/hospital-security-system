{
  "name": "medguard-hospital-security",
  "version": "1.0.0",
  "private": true,
  "description": "A secure hospital records workspace with FastAPI and React.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --config frontend/vite.config.ts --host 0.0.0.0",
    "build": "tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "test": "vitest run --config frontend/vite.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "format:check": "prettier --check frontend/src frontend/vite.config.ts frontend/tsconfig.json frontend/index.html scripts/*.mjs e2e playwright.config.ts",
    "format": "prettier --write frontend/src frontend/vite.config.ts frontend/tsconfig.json frontend/index.html scripts/*.mjs e2e playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
